DEFINE_UI_PARAMS(a, A, DCTLUI_SLIDER_FLOAT, 0, -1, 1, 0.01)
DEFINE_UI_PARAMS(b, B, DCTLUI_SLIDER_FLOAT, 0, -1, 1, 0.01)
DEFINE_UI_PARAMS(c, C, DCTLUI_SLIDER_FLOAT, 0, -1, 1, 0.01)
DEFINE_UI_PARAMS(cx, Center X, DCTLUI_SLIDER_FLOAT, 0, -8192, 8192, 0.01)
DEFINE_UI_PARAMS(cy, Center Y, DCTLUI_SLIDER_FLOAT, 0, -8192, 8192, 0.01)

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    //int length = min(p_Width, p_Height);
    //float2 uv = make_float2((float)p_X / (float)length, (float)p_Y / (float)length);
    float2 uv = make_float2(((float)p_X + (float)cx) / (float)p_Width, ((float)p_Y + (float)cy) / (float)p_Height);

    // Panotools uses UV coordinates with a [-1:1] range
    float2 iuv = (uv * 2.0f) - 1.0f;

    // Compute the distortion
    float x2 = iuv.x * iuv.x;
    float y2 = iuv.y * iuv.y;

    float r2 = x2 + y2;
    float d = 1.0f - (a + b + c);
    float r = _sqrtf(r2);
    float scale = (a * r2 + c) * r + b * r2 + d;

    iuv.x *= scale;
    iuv.y *= scale;

    // Transform the UV coordinates back to a [0:1] range
    iuv = (iuv * 0.5f) + 0.5f;

    //int uvX = (float)iuv.x * (float)length;
    //int uvY = (float)iuv.y * (float)length;
    int uvX = (float)iuv.x * (float)p_Width;
    int uvY = (float)iuv.y * (float)p_Height;

    // Output an RGBA version of the view
    float rColor = _tex2D(p_TexR, uvX, uvY);
    float gColor = _tex2D(p_TexG, uvX, uvY);
    float bColor = _tex2D(p_TexB, uvX, uvY);

    return make_float3(rColor, gColor, bColor);
}
